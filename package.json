{
  "name": "fleet-manager",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.2.0",
  "type": "module",
  "description": "Dashboard over the bwoc CLI for BWOC agent fleets — every workspace and agent in one view.",
  "homepage": "https://github.com/bemindlabs/bwoc-fleet-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bemindlabs/bwoc-fleet-manager.git"
  },
  "bugs": {
    "url": "https://github.com/bemindlabs/bwoc-fleet-manager/issues"
  },
  "author": "BemindLabs (BeMind Technology)",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -n api,ui,planner -c magenta,cyan,yellow \"pnpm dev:api\" \"pnpm dev:ui\" \"pnpm planner\"",
    "dev:api": "node server/index.mjs",
    "dev:ui": "vite",
    "build": "tsc -b && vite build",
    "preview": "SERVE_STATIC=1 node server/index.mjs",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test server/*.test.mjs",
    "planner": "node server/planner-sidecar.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "codemirror": "^6.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
