# Copy to .env and adjust. Compose reads .env automatically.

# Where the fleet lives on the host (bind-mounted read-write into every service)
BWOC_WORKSPACE_ROOT_HOST=${HOME}/Workspaces

# bwoc release the images install (bwoc, bwoc-agent, bwoc-harness come from its
# Linux tarball, sha256-checked). Match the host's `bwoc --version`.
BWOC_RELEASE=v2026.9.26-0

# The BWOC framework source checkout — keep it at the same tag as BWOC_RELEASE.
# It is the Settings catalog (mounted read-only at /framework) and the build
# context for bwoc-mqtt / bwoc-a2a, which the release does not ship.
BWOC_SRC=../BWOC-Framework-build

# Ports (all bound to 127.0.0.1)
FLEET_MANAGER_PORT=8791
MQTT_PORT=1883
MQTT_WS_PORT=9001
A2A_PORT=41241

# MQTT bridge target
BWOC_MQTT_WORKSPACE=learn-atlas
BWOC_MQTT_TOPIC=bwoc/+/inbox

# A2A listener — REQUIRED. The listener refuses a non-loopback bind without it.
# Generate one: openssl rand -hex 32
BWOC_A2A_TOKEN=
A2A_AGENT=agent-prime
A2A_WORKSPACE=learn-atlas

# `--profile agents` only
AGENTD_WORKSPACE=learn-atlas
AGENTD_AGENT=agent-prime

# Planner endpoint as seen FROM the container (localhost would be the container
# itself). host.docker.internal resolves to the host via extra_hosts.
BWOC_HARNESS_ENDPOINT=http://host.docker.internal:11434/v1
BWOC_HARNESS_MODEL=gemma4:latest

# Host planner sidecar — start with `pnpm planner` on the host. The container
# reaches it via host.docker.internal; the harness cannot run in the container.
BWOC_PLANNER_URL=http://host.docker.internal:8792
PLANNER_PORT=8792

# ---- gateway mesh (host sidecar; off until both are set) ----
# BWOC_GW_AGENT=agent-example
# BWOC_GW_RELAY=ws://relay.example.com:10601/v1/connect
# BWOC_GW_MEMBERS=agent-a,agent-b      # room recipients
# BWOC_GW_ROOM=fleet
# BWOC_GW_KICK_CMD=                    # optional: restart the recv bridge after a send
# ---- bwoc update button (Settings) ----
# BWOC_UPDATE_CMD=/path/to/your-update-script.sh
